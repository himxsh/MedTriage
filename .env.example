# .env Template for MedTriage AI
# Copy this to .env and fill in your secrets

# --- AI API Keys (backend only — never expose to Vite) ---
GOOGLE_API_KEY=your_gemini_api_key_here

# --- Database ---
# Format: postgresql+asyncpg://user:password@localhost:5432/medtriage
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/medtriage

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Model Paths ---
WHISPER_MODEL_PATH=models/whisper/small.pt
SCISPACY_MODEL_PATH=models/scispacy/en_ner_bc5cdr_md-0.5.4
CLINICAL_BERT_PATH=models/relations
# STT: whisper | gemini | auto (Whisper then Gemini if empty/short)
STT_BACKEND=auto
# Optional default when intake omits language= (hi|en|empty=auto-detect)
WHISPER_LANGUAGE=
WHISPER_MODEL_SIZE=small
CASE_AUDIO_DIR=case_audio
# See docs/hindi-stt-spike.md before changing size for Hindi voice

# --- App Settings ---
PROJECT_NAME="MedTriage AI"
API_V1_STR="/api/v1"
DEBUG=True

# --- Auth / tenancy ---
# Production behind HTTPS: COOKIE_SECURE=True and ENABLE_HSTS=True
COOKIE_SECURE=False
ENABLE_HSTS=False
ALLOW_PUBLIC_REGISTER=False
# Exact browser origins only (no *). Production example:
# CORS_ORIGINS=https://app.yourhospital.example
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
DEMO_ADMIN_EMAIL=admin@demo.local
DEMO_ADMIN_PASSWORD=demo-change-me
MAX_AUDIO_BYTES=26214400
MAX_TEXT_CHARS=20000

# --- Bind / TLS (ops) ---
# Prefer: reverse proxy terminates TLS → uvicorn on 127.0.0.1:8000
# Never expose uvicorn on 0.0.0.0 to the public internet without that proxy.
# See docs/ops-production.md
