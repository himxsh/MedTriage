# Leave VITE_API_URL unset — browser uses same-origin /api (Vite proxies to uvicorn).
# Cross-origin localhost ↔ 127.0.0.1 drops the httpOnly session cookie (SameSite=Lax).
MEDTRIAGE_PROXY_TARGET=http://127.0.0.1:8001

# Only set these if you must call the API on another origin (cookies will break without HTTPS + SameSite=None):
# VITE_API_URL=http://127.0.0.1:8001
# VITE_WS_URL=ws://127.0.0.1:8001/ws/queue
